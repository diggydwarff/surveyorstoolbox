+package com.surveyorstoolbox.client;
+
+import com.surveyorstoolbox.blueprint.BlueprintData;
+import com.surveyorstoolbox.measurement.MeasurementSnapshot;
+import net.minecraft.ChatFormatting;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.item.ItemStack;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+public final class BlueprintOverlayManager {
+    private static final int MAX_ACTIVE_BLUEPRINTS = 4;
+    private static final Map<UUID, List<MeasurementSnapshot>> ACTIVE = new LinkedHashMap<>();
+    private static Level activeLevel;
+
+    public static void tick(Player player) {
+        if (activeLevel != player.level()) {
+            ACTIVE.clear();
+            activeLevel = player.level();
+        }
+    }
+
+    public static void toggle(ItemStack stack, Player player) {
+        tick(player);
+        UUID id = BlueprintData.getId(stack);
+        String dimension = player.level().dimension().location().toString();
+        List<MeasurementSnapshot> measurements = BlueprintData.readMeasurements(stack, dimension);
+        if (id == null || measurements.isEmpty()) {
+            player.displayClientMessage(Component.literal("This blueprint has no saved measurements for this dimension.")
+                    .withStyle(ChatFormatting.GRAY), true);
+            return;
+        }
+
+        if (ACTIVE.remove(id) != null) {
+            player.displayClientMessage(Component.literal("Blueprint hidden.")
+                    .withStyle(ChatFormatting.GRAY), true);
+            return;
+        }
+
+        if (ACTIVE.size() >= MAX_ACTIVE_BLUEPRINTS) {
+            UUID oldest = ACTIVE.keySet().iterator().next();
+            ACTIVE.remove(oldest);
+        }
+
+        ACTIVE.put(id, measurements);
+        player.displayClientMessage(Component.literal("Blueprint visible: " + measurements.size() + " measurements.")
+                .withStyle(ChatFormatting.AQUA), true);
+    }
+
+    public static List<MeasurementSnapshot> visibleMeasurements() {
+        return ACTIVE.values().stream().flatMap(List::stream).toList();
+    }
+
+    public static void clear() {
+        ACTIVE.clear();
+        activeLevel = null;
+    }
+
+    private BlueprintOverlayManager() { }
+}
