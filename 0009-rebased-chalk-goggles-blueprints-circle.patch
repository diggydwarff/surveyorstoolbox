@@ -0,0 +1,81 @@
+package com.surveyorstoolbox.blueprint;
+
+import com.surveyorstoolbox.measurement.MeasurementSnapshot;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.Tag;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.component.CustomData;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+public final class BlueprintData {
+    private static final String ROOT_KEY = "SurveyorsToolboxBlueprint";
+    private static final int MAX_MEASUREMENTS = 12;
+
+    public static boolean append(ItemStack stack, String dimension, MeasurementSnapshot snapshot) {
+        if (!snapshot.isValidForPersistence()) return false;
+
+        CompoundTag root = stack.getOrDefault(DataComponents.CUSTOM_DATA, CustomData.EMPTY).copyTag();
+        CompoundTag blueprint = root.getCompound(ROOT_KEY);
+
+        if (!blueprint.hasUUID("Id")) {
+            blueprint.putUUID("Id", UUID.randomUUID());
+        }
+
+        ListTag entries = blueprint.getList("Entries", Tag.TAG_COMPOUND);
+        if (entries.size() >= MAX_MEASUREMENTS) return false;
+
+        CompoundTag entry = new CompoundTag();
+        entry.putString("Dimension", dimension);
+        entry.put("Measurement", snapshot.compacted().toTag());
+        entries.add(entry);
+
+        blueprint.put("Entries", entries);
+        root.put(ROOT_KEY, blueprint);
+        CustomData.set(DataComponents.CUSTOM_DATA, stack, root);
+        return true;
+    }
+
+    public static UUID getId(ItemStack stack) {
+        CompoundTag blueprint = getBlueprintTag(stack);
+        return blueprint.hasUUID("Id") ? blueprint.getUUID("Id") : null;
+    }
+
+    public static int countMeasurements(ItemStack stack) {
+        return getBlueprintTag(stack).getList("Entries", Tag.TAG_COMPOUND).size();
+    }
+
+    public static List<MeasurementSnapshot> readMeasurements(ItemStack stack, String dimension) {
+        CompoundTag blueprint = getBlueprintTag(stack);
+        ListTag entries = blueprint.getList("Entries", Tag.TAG_COMPOUND);
+        List<MeasurementSnapshot> out = new ArrayList<>(entries.size());
+
+        for (int i = 0; i < entries.size(); i++) {
+            CompoundTag entry = entries.getCompound(i);
+
+            // Alpha.9 stores an explicit dimension with each measurement.
+            // Direct measurement tags are accepted as a small compatibility fallback.
+            if (entry.contains("Measurement")) {
+                if (!dimension.equals(entry.getString("Dimension"))) continue;
+                MeasurementSnapshot snapshot = MeasurementSnapshot.fromTag(entry.getCompound("Measurement"));
+                if (snapshot.isValidForPersistence()) out.add(snapshot);
+            } else {
+                MeasurementSnapshot snapshot = MeasurementSnapshot.fromTag(entry);
+                if (snapshot.isValidForPersistence()) out.add(snapshot);
+            }
+        }
+
+        return List.copyOf(out);
+    }
+
+    private static CompoundTag getBlueprintTag(ItemStack stack) {
+        CompoundTag root = stack.getOrDefault(DataComponents.CUSTOM_DATA, CustomData.EMPTY).copyTag();
+        return root.getCompound(ROOT_KEY);
+    }
+
+    private BlueprintData() { }
+}
