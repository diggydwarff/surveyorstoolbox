+    private static double blockDeltaDistance(BlockPos a, BlockPos b) {
+        double dx = b.getX() - a.getX();
+        double dy = b.getY() - a.getY();
+        double dz = b.getZ() - a.getZ();
+        return Math.sqrt(dx * dx + dy * dy + dz * dz);
+    }
